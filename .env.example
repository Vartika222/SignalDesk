# Copy to .env and fill in.

# Local dev database (matches docker-compose.yml; dev-only credentials).
DATABASE_URL=postgresql://signaldesk:signaldesk@localhost:5433/signaldesk

# REQUIRED by SEC fair-access policy: identify yourself with a real contact.
# Format the SEC asks for: "Name or Org  contact@email"
# The ingester refuses to run without it.
SEC_USER_AGENT=

# Where raw downloaded files live (not committed).
DATA_DIR=data

# Phase 2+: Claude API key for generation/extraction.
ANTHROPIC_API_KEY=
